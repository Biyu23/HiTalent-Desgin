{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react",
    "baseUrl": "./",
    "paths": {
      "@@/*": [".dumi/tmp/*"],
      "myui": ["src"],
      "myui/*": ["src/*", "*"]
    }
  },
  "include": [
    "src/**/*", // 必须有这个！确保 TS 能扫描到 src 下的 typings.d.ts
    ".dumi/**/*",
    "docs/**/*",
    ".eslintrc.js"
  ]
}
